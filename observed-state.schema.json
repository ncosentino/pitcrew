{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.devleader.ca/projects/pitcrew/schemas/observed-state.schema.json",
  "title": "PitCrew Manager Observed State",
  "description": "Credential-free operational status projected by one PitCrew profile manager.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "resourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuCores",
        "memoryWorkingSetBytes",
        "pids"
      ],
      "properties": {
        "cpuCores": {
          "type": "number",
          "minimum": 0
        },
        "memoryWorkingSetBytes": {
          "type": "integer",
          "minimum": 0
        },
        "pids": {
          "type": "integer",
          "minimum": 0
        },
        "networkRxBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "networkTxBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "blockReadBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "blockWriteBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "resourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryBytes",
        "memorySwapBytes",
        "cpuCores",
        "pids"
      ],
      "properties": {
        "memoryBytes": {
          "type": ["integer", "null"],
          "minimum": 6291456
        },
        "memorySwapBytes": {
          "type": ["integer", "null"],
          "minimum": 6291456
        },
        "cpuCores": {
          "type": ["string", "null"],
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]{1,9})?|0\\.[0-9]{0,8}[1-9])$"
        },
        "pids": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "memorySwapBytes": {
                "type": "integer"
              }
            },
            "required": [
              "memorySwapBytes"
            ]
          },
          "then": {
            "properties": {
              "memoryBytes": {
                "type": "integer"
              }
            }
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "memoryBytes": {
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "memorySwapBytes": {
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "cpuCores": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "pids": {
              "type": "integer"
            }
          }
        }
      ],
      "$comment": "Manager and dashboard validators enforce memorySwapBytes >= memoryBytes."
    },
    "lastExitDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "classification",
        "exitCode",
        "signal",
        "dockerOomKilled",
        "evidence"
      ],
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "classification": {
          "enum": [
            "clean",
            "oom-killed",
            "sigkill",
            "signal",
            "error",
            "launch-failure",
            "unknown"
          ]
        },
        "exitCode": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        },
        "signal": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 64
        },
        "dockerOomKilled": {
          "type": ["boolean", "null"]
        },
        "evidence": {
          "enum": [
            "docker-inspect",
            "docker-wait",
            "launch",
            "unavailable"
          ]
        }
      },
      "$comment": "Classification precedence is Docker-confirmed OOM, SIGKILL, other signal, clean zero, ordinary nonzero error, launch failure, then unknown. Exit code 137 alone never proves OOM."
    },
    "scaleSetStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "availableJobs",
        "acquiredJobs",
        "assignedJobs",
        "runningJobs",
        "registeredRunners",
        "busyRunners",
        "idleRunners"
      ],
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "availableJobs": {
          "type": "integer",
          "minimum": 0
        },
        "acquiredJobs": {
          "type": "integer",
          "minimum": 0
        },
        "assignedJobs": {
          "type": "integer",
          "minimum": 0
        },
        "runningJobs": {
          "type": "integer",
          "minimum": 0
        },
        "registeredRunners": {
          "type": "integer",
          "minimum": 0
        },
        "busyRunners": {
          "type": "integer",
          "minimum": 0
        },
        "idleRunners": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "autoscalingTargetState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "repository",
        "maximumSlots",
        "targetSlots",
        "localActiveWorkers",
        "localIdleWorkers",
        "localBusyWorkers",
        "localDrainingWorkers",
        "statistics"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": ["string", "null"]
        },
        "maximumSlots": {
          "type": "integer",
          "minimum": 0
        },
        "targetSlots": {
          "type": "integer",
          "minimum": 0
        },
        "localActiveWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "localIdleWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "localBusyWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "localDrainingWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "statistics": {
          "oneOf": [
            {
              "$ref": "#/$defs/scaleSetStatistics"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "hostResourceCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalProcessorCount",
        "memoryBytes"
      ],
      "properties": {
        "logicalProcessorCount": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "managerResourceTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampledAt",
        "status",
        "host",
        "manager"
      ],
      "properties": {
        "sampledAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": ["available", "partial", "unavailable"]
        },
        "host": {
          "oneOf": [
            {
              "$ref": "#/$defs/hostResourceCapacity"
            },
            {
              "type": "null"
            }
          ]
        },
        "manager": {
          "oneOf": [
            {
              "$ref": "#/$defs/resourceUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "autoscalingState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "minimumIdleSlots",
        "maximumSlots",
        "targetSlots",
        "assignedJobs",
        "runningJobs",
        "availableJobs",
        "idleRunners",
        "busyRunners",
        "scaleDownDelaySeconds",
        "scaleDownAt",
        "scaleSetCount",
        "lastError"
      ],
      "properties": {
        "mode": {
          "const": "scale-set"
        },
        "status": {
          "enum": ["starting", "running", "degraded", "stopping"]
        },
        "minimumIdleSlots": {
          "type": "integer",
          "minimum": 0
        },
        "maximumSlots": {
          "type": "integer",
          "minimum": 0
        },
        "targetSlots": {
          "type": "integer",
          "minimum": 0
        },
        "assignedJobs": {
          "type": "integer",
          "minimum": 0
        },
        "runningJobs": {
          "type": "integer",
          "minimum": 0
        },
        "availableJobs": {
          "type": "integer",
          "minimum": 0
        },
        "idleRunners": {
          "type": "integer",
          "minimum": 0
        },
        "busyRunners": {
          "type": "integer",
          "minimum": 0
        },
        "scaleDownDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "scaleDownAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "scaleSetCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastError": {
          "type": ["string", "null"]
        },
        "maximumActiveWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/autoscalingTargetState"
          }
        }
      }
    },
    "sanitizedEvidence": {
      "type": ["string", "null"],
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 .,_()'-]*$",
      "$comment": "Short operator-facing explanation. The character set excludes ':', '/', '@', '?', '=', and '&' so URLs, tokens, headers, and raw command output cannot be relayed."
    },
    "managerEventSubsystem": {
      "enum": [
        "docker",
        "registration",
        "scale-set-session",
        "listener",
        "jit",
        "worker-launch",
        "worker-exit",
        "telemetry",
        "reconciliation",
        "cleanup",
        "admission",
        "recovery"
      ]
    },
    "managerEventOperation": {
      "enum": [
        "docker-ping",
        "docker-run",
        "docker-inspect",
        "docker-remove",
        "docker-events",
        "registration-token-request",
        "runner-registration",
        "runner-removal",
        "session-create",
        "session-refresh",
        "session-delete",
        "message-poll",
        "message-acknowledge",
        "jit-config-generate",
        "worker-launch",
        "worker-exit",
        "telemetry-sample",
        "desired-state-load",
        "desired-state-apply",
        "capacity-acknowledge",
        "observed-state-publish",
        "registration-cleanup",
        "container-cleanup",
        "admission-reserve",
        "admission-settle",
        "manager-start",
        "manager-shutdown",
        "journal-restore"
      ],
      "$comment": "Closed vocabulary. Managers must not invent operation names; a new operation requires a new manager contract version."
    },
    "managerEventOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "timed-out",
        "retry-scheduled",
        "blocked",
        "recovered",
        "unknown"
      ]
    },
    "managerEventReason": {
      "enum": [
        "none",
        "docker-unavailable",
        "docker-failed",
        "timeout",
        "rate-limited",
        "authorization-failed",
        "not-found",
        "conflict",
        "invalid-state",
        "capacity-ceiling",
        "retry-backoff",
        "cancelled",
        "recovered",
        "unknown"
      ]
    },
    "managerEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "managerInstanceId",
        "observedAt",
        "subsystem",
        "operation",
        "target",
        "outcome",
        "durationMilliseconds",
        "attempt",
        "consecutiveFailures",
        "retryAt",
        "reason",
        "evidence"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "managerInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "subsystem": {
          "$ref": "#/$defs/managerEventSubsystem"
        },
        "operation": {
          "$ref": "#/$defs/managerEventOperation"
        },
        "target": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128,
          "$comment": "Slot key or autoscaling target key that already appears in non-secret observed state. No container identity, URL, or free-form identifier."
        },
        "outcome": {
          "$ref": "#/$defs/managerEventOutcome"
        },
        "durationMilliseconds": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 86400000,
          "$comment": "null means the manager did not measure the operation; 0 means it measured a sub-millisecond operation."
        },
        "attempt": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 1000
        },
        "consecutiveFailures": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 1000
        },
        "retryAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "reason": {
          "$ref": "#/$defs/managerEventReason"
        },
        "evidence": {
          "$ref": "#/$defs/sanitizedEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "succeeded"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "none",
                  "recovered"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "failed",
                  "timed-out",
                  "blocked"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "retry-scheduled"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "retryAt": {
                "type": "string"
              }
            }
          }
        }
      ],
      "$comment": "Dashboards deduplicate on profileId plus sequence. Sequence is durable and monotonic across manager restart and hot-swap, so managerInstanceId identifies the observer rather than the identity of the event."
    },
    "managerOperationJournal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "capacity",
        "highestSequence",
        "droppedEvents",
        "events"
      ],
      "properties": {
        "status": {
          "enum": ["current", "truncated", "unavailable"],
          "$comment": "current means the retained window is intact, truncated means older or rejected entries were discarded, unavailable means the manager could not read or restore its journal."
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "highestSequence": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "droppedEvents": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/managerEvent"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "events": {
                "maxItems": 0
              },
              "highestSequence": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "truncated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "droppedEvents": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "events": {
                "minItems": 1
              }
            },
            "required": [
              "events"
            ]
          },
          "then": {
            "properties": {
              "highestSequence": {
                "type": "integer"
              }
            }
          }
        }
      ],
      "$comment": "The journal retains failures, state transitions, retries, and recovery rather than every reconciliation pass. An empty events array with status current means no notable event has occurred. Malformed or oversized persisted entries are discarded into droppedEvents; the rest of observed state stays valid. Serialized journal size is capped at 16384 bytes."
    },
    "subsystemOperationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "observedAt",
        "durationMilliseconds",
        "reason",
        "evidence"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/managerEventOperation"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMilliseconds": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 86400000
        },
        "reason": {
          "$ref": "#/$defs/managerEventReason"
        },
        "evidence": {
          "$ref": "#/$defs/sanitizedEvidence"
        }
      }
    },
    "subsystemHealthSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "observedAt",
        "consecutiveFailures",
        "retryAt",
        "lastSuccess",
        "lastFailure"
      ],
      "properties": {
        "state": {
          "enum": ["healthy", "degraded", "unavailable", "unknown"]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "consecutiveFailures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "retryAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "lastSuccess": {
          "oneOf": [
            {
              "$ref": "#/$defs/subsystemOperationEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastFailure": {
          "oneOf": [
            {
              "$ref": "#/$defs/subsystemOperationEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "healthy"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "consecutiveFailures": {
                "const": 0
              },
              "lastSuccess": {
                "$ref": "#/$defs/subsystemOperationEvidence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["degraded", "unavailable"]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "consecutiveFailures": {
                "minimum": 1
              },
              "lastFailure": {
                "$ref": "#/$defs/subsystemOperationEvidence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "consecutiveFailures": {
                "const": 0
              },
              "lastSuccess": {
                "type": "null"
              },
              "lastFailure": {
                "type": "null"
              },
              "retryAt": {
                "type": "null"
              }
            }
          }
        }
      ],
      "$comment": "These summaries describe operations this manager performed. They never claim that the host, Docker daemon, network, or GitHub service as a whole is healthy."
    },
    "managerSubsystemHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docker",
        "github"
      ],
      "properties": {
        "docker": {
          "$ref": "#/$defs/subsystemHealthSummary"
        },
        "github": {
          "$ref": "#/$defs/subsystemHealthSummary"
        }
      }
    },
    "capacityDeficitReason": {
      "enum": [
        "none",
        "admission-ceiling",
        "launch-pending",
        "docker-unavailable",
        "docker-failed",
        "jit-pending",
        "jit-failed",
        "listener-unavailable",
        "session-unavailable",
        "registration-cleanup-pending",
        "worker-draining",
        "invalid-desired-state",
        "retry-backoff",
        "unknown"
      ],
      "$comment": "Observed manager state, not a diagnosis inferred by a dashboard. A configured autoscaling maximum is not a health target and never creates a deficit by itself."
    },
    "capacityDeficitCore": {
      "type": "object",
      "required": [
        "observedAt",
        "freshness",
        "targetSlots",
        "activeWorkers",
        "startingWorkers",
        "drainingWorkers",
        "cleanupPendingWorkers",
        "eligibleWorkers",
        "localDeficit",
        "eligibilityDeficit",
        "reason",
        "evidence"
      ],
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "freshness": {
          "enum": ["current", "stale", "unavailable"]
        },
        "targetSlots": {
          "type": "integer",
          "minimum": 0,
          "$comment": "desiredSlots for fixed profiles and the activation targetSlots for an autoscaling target. It is never the configured maximum."
        },
        "activeWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "startingWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "drainingWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "cleanupPendingWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "eligibleWorkers": {
          "type": ["integer", "null"],
          "minimum": 0,
          "$comment": "GitHub-registered or scale-set-eligible evidence. null means the manager has no current control-plane evidence; 0 means it observed none."
        },
        "localDeficit": {
          "type": "integer",
          "minimum": 0
        },
        "eligibilityDeficit": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "reason": {
          "$ref": "#/$defs/capacityDeficitReason"
        },
        "evidence": {
          "$ref": "#/$defs/sanitizedEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "localDeficit": {
                "minimum": 1
              }
            },
            "required": [
              "localDeficit"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligibleWorkers": {
                "type": "null"
              }
            },
            "required": [
              "eligibleWorkers"
            ]
          },
          "then": {
            "properties": {
              "eligibilityDeficit": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligibleWorkers": {
                "type": "integer"
              }
            },
            "required": [
              "eligibleWorkers"
            ]
          },
          "then": {
            "properties": {
              "eligibilityDeficit": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "freshness": {
                "const": "unavailable"
              }
            },
            "required": [
              "freshness"
            ]
          },
          "then": {
            "properties": {
              "eligibleWorkers": {
                "type": "null"
              },
              "reason": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "capacityDeficitEvidence": {
      "allOf": [
        {
          "$ref": "#/$defs/capacityDeficitCore"
        }
      ],
      "unevaluatedProperties": false
    },
    "targetCapacityDeficitEvidence": {
      "allOf": [
        {
          "$ref": "#/$defs/capacityDeficitCore"
        },
        {
          "type": "object",
          "required": [
            "key",
            "repository"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "repository": {
              "type": ["string", "null"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "managerCapacityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed",
        "targets"
      ],
      "properties": {
        "fixed": {
          "oneOf": [
            {
              "$ref": "#/$defs/capacityDeficitEvidence"
            },
            {
              "type": "null"
            }
          ],
          "$comment": "null for an autoscaled profile, which reports per-target evidence instead."
        },
        "targets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/targetCapacityDeficitEvidence"
          }
        }
      }
    },
    "updateState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "targetRevision",
          "currentWorkers",
          "staleWorkers",
          "lastError"
        ],
        "properties": {
          "status": {
            "enum": ["current", "rolling", "degraded"]
          },
          "targetImage": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^\\S+$"
          },
          "targetImageId": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "targetRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "currentWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "staleWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "lastError": {
            "type": ["string", "null"]
          }
        }
      }
  },
  "required": [
    "schemaVersion",
    "managerContractVersion",
    "profileId",
    "managerInstanceId",
    "managerStatus",
    "observedAt",
    "scope",
    "generation",
    "desiredStateHash",
    "desiredStateStatus",
    "desiredSlots",
    "activeSlots",
    "drainingSlots",
    "slots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "managerContractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "managerInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "managerStatus": {
      "enum": ["starting", "running", "stopping", "stopped"]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "enum": ["repo", "org", "ent"]
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "desiredStateHash": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "desiredStateStatus": {
      "enum": ["waiting", "accepted", "invalid", "stale", "conflict"]
    },
    "desiredSlots": {
      "type": "integer",
      "minimum": 0
    },
    "configuredSlots": {
      "type": "integer",
      "minimum": 0
    },
    "activeSlots": {
      "type": "integer",
      "minimum": 0
    },
    "eligibleSlots": {
      "type": "integer",
      "minimum": 0
    },
    "drainingSlots": {
      "type": "integer",
      "minimum": 0
    },
    "resourceTelemetry": {
      "oneOf": [
        {
          "$ref": "#/$defs/managerResourceTelemetry"
        },
        {
          "type": "null"
        }
      ]
    },
    "resourcePolicy": {
      "oneOf": [
        {
          "$ref": "#/$defs/resourcePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "autoscaling": {
      "oneOf": [
        {
          "$ref": "#/$defs/autoscalingState"
        },
        {
          "type": "null"
        }
      ]
    },
    "update": {
      "oneOf": [
        {
          "$ref": "#/$defs/updateState"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationJournal": {
      "oneOf": [
        {
          "$ref": "#/$defs/managerOperationJournal"
        },
        {
          "type": "null"
        }
      ]
    },
    "subsystemHealth": {
      "oneOf": [
        {
          "$ref": "#/$defs/managerSubsystemHealth"
        },
        {
          "type": "null"
        }
      ]
    },
    "capacityEvidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/managerCapacityEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "repository",
          "desired",
          "processRunning",
          "state",
          "failureCount",
          "backoffSeconds",
          "updatedAt"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": ["string", "null"]
          },
          "desired": {
            "type": "boolean"
          },
          "processRunning": {
            "type": "boolean"
          },
          "state": {
            "enum": ["starting", "online", "backoff", "restarting", "draining", "stopped"]
          },
          "failureCount": {
            "type": "integer",
            "minimum": 0
          },
          "backoffSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "updatedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "resources": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "activity": {
            "type": ["string", "null"],
            "enum": ["starting", "idle", "busy", "draining", "unknown", null]
          },
          "target": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "registrationStatus": {
            "enum": ["connected", "disconnected", "registration-missing", "unknown"]
          },
          "imageId": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "lastExit": {
            "oneOf": [
              {
                "$ref": "#/$defs/lastExitDiagnostic"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 7
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "resourceTelemetry"
        ],
        "properties": {
          "resourceTelemetry": {
            "$ref": "#/$defs/managerResourceTelemetry"
          },
          "slots": {
            "items": {
              "required": [
                "resources"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resourceTelemetry": {
            "type": "object",
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "resourceTelemetry"
        ]
      },
      "then": {
        "properties": {
          "resourceTelemetry": {
            "properties": {
              "host": {
                "$ref": "#/$defs/hostResourceCapacity"
              },
              "manager": {
                "$ref": "#/$defs/resourceUsage"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resourceTelemetry": {
            "type": "object",
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "resourceTelemetry"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "resourceTelemetry": {
                "properties": {
                  "host": {
                    "$ref": "#/$defs/hostResourceCapacity"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "resourceTelemetry": {
                "properties": {
                  "manager": {
                    "$ref": "#/$defs/resourceUsage"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "slots": {
                "contains": {
                  "properties": {
                    "resources": {
                      "$ref": "#/$defs/resourceUsage"
                    }
                  },
                  "required": [
                    "resources"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "resourceTelemetry": {
            "type": "object",
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "resourceTelemetry"
        ]
      },
      "then": {
        "properties": {
          "resourceTelemetry": {
            "properties": {
              "host": {
                "type": "null"
              },
              "manager": {
                "type": "null"
              }
            }
          },
          "slots": {
            "items": {
              "properties": {
                "resources": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 8
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "configuredSlots",
          "autoscaling"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 9
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "update"
        ],
        "properties": {
          "update": {
            "$ref": "#/$defs/updateState"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 10
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "eligibleSlots"
        ],
        "properties": {
          "slots": {
            "items": {
              "required": [
                "registrationStatus"
              ]
            }
          }
        },
        "$comment": "eligibleSlots equals the number of slots whose registrationStatus is connected; enforced by manager and dashboard validators."
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 11
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "resourcePolicy"
        ],
        "properties": {
          "autoscaling": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/autoscalingState"
                  },
                  {
                    "required": [
                      "maximumActiveWorkers",
                      "targets"
                    ]
                  }
                ]
              }
            ]
          },
          "slots": {
            "items": {
              "required": [
                "imageId",
                "lastExit"
              ],
              "properties": {
                "resources": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "allOf": [
                        {
                          "$ref": "#/$defs/resourceUsage"
                        },
                        {
                          "required": [
                            "networkRxBytes",
                            "networkTxBytes",
                            "blockReadBytes",
                            "blockWriteBytes"
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "$comment": "Local worker counts and timestamped GitHub scale-set statistics are separate evidence. Neither source makes a mismatched runner automatically removable."
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 12
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "operationJournal",
          "subsystemHealth",
          "capacityEvidence"
        ],
        "properties": {
          "operationJournal": {
            "$ref": "#/$defs/managerOperationJournal"
          },
          "subsystemHealth": {
            "$ref": "#/$defs/managerSubsystemHealth"
          },
          "capacityEvidence": {
            "$ref": "#/$defs/managerCapacityEvidence"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "autoscaling": {
                  "type": "object"
                }
              },
              "required": [
                "autoscaling"
              ]
            },
            "then": {
              "properties": {
                "capacityEvidence": {
                  "properties": {
                    "fixed": {
                      "type": "null"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "capacityEvidence": {
                  "properties": {
                    "fixed": {
                      "$ref": "#/$defs/capacityDeficitEvidence"
                    },
                    "targets": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          }
        ],
        "$comment": "Contract 12 adds durable operation evidence. The journal, subsystem summaries, and capacity evidence are additive and nullable for contract 11 and older observations, so contract-10 and contract-11 readers are unaffected."
      }
    }
  ]
}
