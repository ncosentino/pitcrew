{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.devleader.ca/projects/pitcrew/schemas/observed-state.schema.json",
  "title": "PitCrew Manager Observed State",
  "description": "Credential-free operational status projected by one PitCrew profile manager.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "resourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuCores",
        "memoryWorkingSetBytes",
        "pids"
      ],
      "properties": {
        "cpuCores": {
          "type": "number",
          "minimum": 0
        },
        "memoryWorkingSetBytes": {
          "type": "integer",
          "minimum": 0
        },
        "pids": {
          "type": "integer",
          "minimum": 0
        },
        "networkRxBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "networkTxBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "blockReadBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "blockWriteBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "resourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryBytes",
        "memorySwapBytes",
        "cpuCores",
        "pids"
      ],
      "properties": {
        "memoryBytes": {
          "type": ["integer", "null"],
          "minimum": 6291456
        },
        "memorySwapBytes": {
          "type": ["integer", "null"],
          "minimum": 6291456
        },
        "cpuCores": {
          "type": ["string", "null"],
          "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]{1,9})?|0\\.[0-9]{0,8}[1-9])$"
        },
        "pids": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "memorySwapBytes": {
                "type": "integer"
              }
            },
            "required": [
              "memorySwapBytes"
            ]
          },
          "then": {
            "properties": {
              "memoryBytes": {
                "type": "integer"
              }
            }
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "memoryBytes": {
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "memorySwapBytes": {
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "cpuCores": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "pids": {
              "type": "integer"
            }
          }
        }
      ],
      "$comment": "Manager and dashboard validators enforce memorySwapBytes >= memoryBytes."
    },
    "lastExitDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "classification",
        "exitCode",
        "signal",
        "dockerOomKilled",
        "evidence"
      ],
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "classification": {
          "enum": [
            "clean",
            "oom-killed",
            "sigkill",
            "signal",
            "error",
            "launch-failure",
            "unknown"
          ]
        },
        "exitCode": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        },
        "signal": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 64
        },
        "dockerOomKilled": {
          "type": ["boolean", "null"]
        },
        "evidence": {
          "enum": [
            "docker-inspect",
            "docker-wait",
            "launch",
            "unavailable"
          ]
        }
      },
      "$comment": "Classification precedence is Docker-confirmed OOM, SIGKILL, other signal, clean zero, ordinary nonzero error, launch failure, then unknown. Exit code 137 alone never proves OOM."
    },
    "scaleSetStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "availableJobs",
        "acquiredJobs",
        "assignedJobs",
        "runningJobs",
        "registeredRunners",
        "busyRunners",
        "idleRunners"
      ],
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "availableJobs": {
          "type": "integer",
          "minimum": 0
        },
        "acquiredJobs": {
          "type": "integer",
          "minimum": 0
        },
        "assignedJobs": {
          "type": "integer",
          "minimum": 0
        },
        "runningJobs": {
          "type": "integer",
          "minimum": 0
        },
        "registeredRunners": {
          "type": "integer",
          "minimum": 0
        },
        "busyRunners": {
          "type": "integer",
          "minimum": 0
        },
        "idleRunners": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "autoscalingTargetState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "repository",
        "maximumSlots",
        "targetSlots",
        "localActiveWorkers",
        "localIdleWorkers",
        "localBusyWorkers",
        "localDrainingWorkers",
        "statistics"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": ["string", "null"]
        },
        "maximumSlots": {
          "type": "integer",
          "minimum": 0
        },
        "targetSlots": {
          "type": "integer",
          "minimum": 0
        },
        "localActiveWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "localIdleWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "localBusyWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "localDrainingWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "statistics": {
          "oneOf": [
            {
              "$ref": "#/$defs/scaleSetStatistics"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "hostResourceCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalProcessorCount",
        "memoryBytes"
      ],
      "properties": {
        "logicalProcessorCount": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "managerResourceTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampledAt",
        "status",
        "host",
        "manager"
      ],
      "properties": {
        "sampledAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": ["available", "partial", "unavailable"]
        },
        "host": {
          "oneOf": [
            {
              "$ref": "#/$defs/hostResourceCapacity"
            },
            {
              "type": "null"
            }
          ]
        },
        "manager": {
          "oneOf": [
            {
              "$ref": "#/$defs/resourceUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "autoscalingState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "minimumIdleSlots",
        "maximumSlots",
        "targetSlots",
        "assignedJobs",
        "runningJobs",
        "availableJobs",
        "idleRunners",
        "busyRunners",
        "scaleDownDelaySeconds",
        "scaleDownAt",
        "scaleSetCount",
        "lastError"
      ],
      "properties": {
        "mode": {
          "const": "scale-set"
        },
        "status": {
          "enum": ["starting", "running", "degraded", "stopping"]
        },
        "minimumIdleSlots": {
          "type": "integer",
          "minimum": 0
        },
        "maximumSlots": {
          "type": "integer",
          "minimum": 0
        },
        "targetSlots": {
          "type": "integer",
          "minimum": 0
        },
        "assignedJobs": {
          "type": "integer",
          "minimum": 0
        },
        "runningJobs": {
          "type": "integer",
          "minimum": 0
        },
        "availableJobs": {
          "type": "integer",
          "minimum": 0
        },
        "idleRunners": {
          "type": "integer",
          "minimum": 0
        },
        "busyRunners": {
          "type": "integer",
          "minimum": 0
        },
        "scaleDownDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "scaleDownAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "scaleSetCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastError": {
          "type": ["string", "null"]
        },
        "maximumActiveWorkers": {
          "type": "integer",
          "minimum": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/autoscalingTargetState"
          }
        }
      }
    },
    "updateState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "targetRevision",
          "currentWorkers",
          "staleWorkers",
          "lastError"
        ],
        "properties": {
          "status": {
            "enum": ["current", "rolling", "degraded"]
          },
          "targetRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "currentWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "staleWorkers": {
            "type": "integer",
            "minimum": 0
          },
          "lastError": {
            "type": ["string", "null"]
          }
        }
      }
  },
  "required": [
    "schemaVersion",
    "managerContractVersion",
    "profileId",
    "managerInstanceId",
    "managerStatus",
    "observedAt",
    "scope",
    "generation",
    "desiredStateHash",
    "desiredStateStatus",
    "desiredSlots",
    "activeSlots",
    "drainingSlots",
    "slots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "managerContractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "managerInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "managerStatus": {
      "enum": ["starting", "running", "stopping", "stopped"]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "enum": ["repo", "org", "ent"]
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "desiredStateHash": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "desiredStateStatus": {
      "enum": ["waiting", "accepted", "invalid", "stale", "conflict"]
    },
    "desiredSlots": {
      "type": "integer",
      "minimum": 0
    },
    "configuredSlots": {
      "type": "integer",
      "minimum": 0
    },
    "activeSlots": {
      "type": "integer",
      "minimum": 0
    },
    "eligibleSlots": {
      "type": "integer",
      "minimum": 0
    },
    "drainingSlots": {
      "type": "integer",
      "minimum": 0
    },
    "resourceTelemetry": {
      "oneOf": [
        {
          "$ref": "#/$defs/managerResourceTelemetry"
        },
        {
          "type": "null"
        }
      ]
    },
    "resourcePolicy": {
      "oneOf": [
        {
          "$ref": "#/$defs/resourcePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "autoscaling": {
      "oneOf": [
        {
          "$ref": "#/$defs/autoscalingState"
        },
        {
          "type": "null"
        }
      ]
    },
    "update": {
      "oneOf": [
        {
          "$ref": "#/$defs/updateState"
        },
        {
          "type": "null"
        }
      ]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "repository",
          "desired",
          "processRunning",
          "state",
          "failureCount",
          "backoffSeconds",
          "updatedAt"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": ["string", "null"]
          },
          "desired": {
            "type": "boolean"
          },
          "processRunning": {
            "type": "boolean"
          },
          "state": {
            "enum": ["starting", "online", "backoff", "restarting", "draining", "stopped"]
          },
          "failureCount": {
            "type": "integer",
            "minimum": 0
          },
          "backoffSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "updatedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "resources": {
            "oneOf": [
              {
                "$ref": "#/$defs/resourceUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "activity": {
            "type": ["string", "null"],
            "enum": ["starting", "idle", "busy", "draining", "unknown", null]
          },
          "target": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "registrationStatus": {
            "enum": ["connected", "disconnected", "registration-missing", "unknown"]
          },
          "imageId": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "lastExit": {
            "oneOf": [
              {
                "$ref": "#/$defs/lastExitDiagnostic"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 7
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "resourceTelemetry"
        ],
        "properties": {
          "resourceTelemetry": {
            "$ref": "#/$defs/managerResourceTelemetry"
          },
          "slots": {
            "items": {
              "required": [
                "resources"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resourceTelemetry": {
            "type": "object",
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "resourceTelemetry"
        ]
      },
      "then": {
        "properties": {
          "resourceTelemetry": {
            "properties": {
              "host": {
                "$ref": "#/$defs/hostResourceCapacity"
              },
              "manager": {
                "$ref": "#/$defs/resourceUsage"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resourceTelemetry": {
            "type": "object",
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "resourceTelemetry"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "resourceTelemetry": {
                "properties": {
                  "host": {
                    "$ref": "#/$defs/hostResourceCapacity"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "resourceTelemetry": {
                "properties": {
                  "manager": {
                    "$ref": "#/$defs/resourceUsage"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "slots": {
                "contains": {
                  "properties": {
                    "resources": {
                      "$ref": "#/$defs/resourceUsage"
                    }
                  },
                  "required": [
                    "resources"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "resourceTelemetry": {
            "type": "object",
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "resourceTelemetry"
        ]
      },
      "then": {
        "properties": {
          "resourceTelemetry": {
            "properties": {
              "host": {
                "type": "null"
              },
              "manager": {
                "type": "null"
              }
            }
          },
          "slots": {
            "items": {
              "properties": {
                "resources": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 8
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "configuredSlots",
          "autoscaling"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 9
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "update"
        ],
        "properties": {
          "update": {
            "$ref": "#/$defs/updateState"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 10
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "eligibleSlots"
        ],
        "properties": {
          "slots": {
            "items": {
              "required": [
                "registrationStatus"
              ]
            }
          }
        },
        "$comment": "eligibleSlots equals the number of slots whose registrationStatus is connected; enforced by manager and dashboard validators."
      }
    },
    {
      "if": {
        "properties": {
          "managerContractVersion": {
            "minimum": 11
          }
        },
        "required": [
          "managerContractVersion"
        ]
      },
      "then": {
        "required": [
          "resourcePolicy"
        ],
        "properties": {
          "autoscaling": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/autoscalingState"
                  },
                  {
                    "required": [
                      "maximumActiveWorkers",
                      "targets"
                    ]
                  }
                ]
              }
            ]
          },
          "slots": {
            "items": {
              "required": [
                "imageId",
                "lastExit"
              ],
              "properties": {
                "resources": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "allOf": [
                        {
                          "$ref": "#/$defs/resourceUsage"
                        },
                        {
                          "required": [
                            "networkRxBytes",
                            "networkTxBytes",
                            "blockReadBytes",
                            "blockWriteBytes"
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "$comment": "Local worker counts and timestamped GitHub scale-set statistics are separate evidence. Neither source makes a mismatched runner automatically removable."
      }
    }
  ]
}
